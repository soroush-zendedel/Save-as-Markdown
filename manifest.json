{
  "manifest_version": 3,
  "name": "Save as Markdown",
  "version": "1.0.0",
  "description": "Extract readable page content, preview it, and save it as Markdown.",
  "icons": {
    "48": "icons/save-markdown.svg",
    "96": "icons/save-markdown.svg",
    "128": "icons/save-markdown.svg"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage", "contextMenus"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Save page as Markdown",
    "default_icon": "icons/save-markdown.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "save-as-markdown@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "128.0"
    }
  }
}
